    },
    {
      "name": "Tickets",
      "description": "Gestión de incidencias técnicas y soporte."
    },
    {
      "name": "Payments",
      "description": "Pagos, facturación recurrente y cobros."
    },
    {
      "name": "Repository",
      "description": "Bóveda de archivos y gestión documental."
    },
    {
      "name": "Database",
      "description": "Operaciones administrativas sobre MongoDB."
    },
    {
      "name": "Teams",
      "description": "Grupos de trabajo y técnicos."
    },
    {
      "name": "Push Notifications",
      "description": "Endpoints para gestión de notificaciones push de escritorio"
    },
    {
      "name": "Users V2",
      "description": "Gestión avanzada de técnicos y usuarios (v2)"
    },
    {
      "name": "MongoDB Servers",
      "description": "Gestión de múltiples instancias de bases de datos"
    }
